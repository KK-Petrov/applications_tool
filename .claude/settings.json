{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv run python tasks.py:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(python tasks.py:*)",
      "Bash(python .claude/hooks/criteria_guard.py)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./.secrets/**)",
      "Edit(./.secrets/**)",
      "Read(/.secrets/**)",
      "Edit(/.secrets/**)",
      "Read(//c/Users/kaloy/OneDrive/Documents/Application information/**)",
      "Edit(//c/Users/kaloy/OneDrive/Documents/Application information/**)",
      "Read(C:/Users/kaloy/OneDrive/Documents/Application information/**)",
      "Edit(C:/Users/kaloy/OneDrive/Documents/Application information/**)",
      "Read(C:\\Users\\kaloy\\OneDrive\\Documents\\Application information\\**)",
      "Edit(C:\\Users\\kaloy\\OneDrive\\Documents\\Application information\\**)",
      "Bash(git push:*)",
      "Edit(./config/criteria.lock.json)",
      "Bash(python .claude/hooks/criteria_guard.py --relock:*)",
      "Bash(python3 .claude/hooks/criteria_guard.py --relock:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_on_edit.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests_on_stop.py\""
          }
        ]
      }
    ]
  }
}
